frontend/coverage
frontend/e2e/test-results
frontend/playwright-report
backend/.venv
backend/staticfiles
backend/frontend_dist
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
backend/.coverage
backend/htmlcov
