# Copy to .env and replace the placeholder values. Never commit .env.

# --- PostgreSQL (used by the db service and to build DATABASE_URL) ---
POSTGRES_DB=clearline
POSTGRES_USER=clearline
# Use letters/numbers only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=changeme
# Host port for Postgres (change it if a local Postgres already uses 5432).
POSTGRES_HOST_PORT=5432

# --- Django ---
# Required, at least 50 characters (it also signs JWTs). Generate one with:
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secret-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origins allowed to call the API (comma-separated).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origins trusted for CSRF (the admin), comma-separated. Production: https://<your domain>
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Production only (Railway; see docs/DEPLOY.md) ---
# Behind an HTTPS proxy: SSL redirect, secure cookies, HSTS. Leave False locally.
DJANGO_HTTPS=False
# HSTS duration in seconds once DJANGO_HTTPS is on (start low, e.g. 3600).
DJANGO_SECURE_HSTS_SECONDS=0
# Reverse proxies in front of Django (client IP for rate limiting via X-Forwarded-For).
DJANGO_NUM_PROXIES=0
# Header a trusted proxy overwrites with the client IP; wins over DJANGO_NUM_PROXIES for
# rate limiting. Railway: X-Real-IP. Leave empty locally (clients could spoof it).
DJANGO_CLIENT_IP_HEADER=
# gunicorn workers in the production image.
WEB_CONCURRENCY=2

# --- Public demo mode (docs/DEPLOY.md §5) ---
# The demo passwords are shown on the login page when DEMO_MODE is on.
DEMO_MODE=False
DEMO_RECEPTIONIST_PASSWORD=changeme
DEMO_PATIENT_PASSWORD=changeme
