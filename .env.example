# Copy to .env and replace the placeholder values. Never commit .env.

# --- PostgreSQL (used by the db service and to build DATABASE_URL) ---
POSTGRES_DB=clearline
POSTGRES_USER=clearline
# Use letters/numbers only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=changeme

# --- Django ---
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secret-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origins allowed to call the API (comma-separated).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
